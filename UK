namespace UK
{
    public partial class Form1 : Form
    {
        int step = 0;
        public Form1()
        {
            InitializeComponent();
        }

        private void pictureBox1_Paint(object sender, PaintEventArgs e)
        {
            Graphics g = e.Graphics;

            int w = 1100;
            int h = 500;

            // alpha: 0 → 255 (60 sekundda)
            int alpha = step * 255 / 60;
            Color blue = Color.FromArgb(alpha, 0, 0, 255);
            Color white = Color.FromArgb(alpha, 255, 255, 255);
            Color red = Color.FromArgb(alpha, 255, 0, 0);

            Brush blueBrush = new SolidBrush(blue);
            Pen whitePen = new Pen(white, 40);
            Pen redPen = new Pen(red, 20);

            // Fon
            g.FillRectangle(blueBrush, 0, 0, w, h);

            // Diagonallar
            g.DrawLine(whitePen, 0, 0, w, h);
            g.DrawLine(whitePen, w, 0, 0, h);
            g.DrawLine(redPen, 0, 0, w, h);
            g.DrawLine(redPen, w, 0, 0, h);

            // Markaziy chiziqlar
            g.FillRectangle(new SolidBrush(white), w / 2 - 50, 0, 100, h);
            g.FillRectangle(new SolidBrush(white), 0, h / 2 - 50, w, 100);
            g.FillRectangle(new SolidBrush(red), w / 2 - 25, 0, 50, h);
            g.FillRectangle(new SolidBrush(red), 0, h / 2 - 25, w, 50);
        }

        private void timer1_Tick(object sender, EventArgs e)
        {
            if (step < 60)
            {
                step++;
                pictureBox1.Invalidate();
                label2.Text = $"{step} / 60s";
            }
            else
            {
                timer1.Stop();
            }
        }
    }
}
